{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-wiki.invalid/schemas/wiki.schema.json",
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "$ref": "provenance.schema.json"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "card.schema.json"
          },
          "minItems": 0
        },
        "relations": {
          "$ref": "relations.schema.json"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "sources",
        "cards",
        "relations"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "sha256-refs"
        },
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        }
      },
      "required": [
        "encoding",
        "schema_version",
        "revision",
        "sources",
        "cards",
        "relations"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "$ref": "provenance.schema.json"
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "card.schema.json"
      },
      "minItems": 0
    },
    "relations": {
      "$ref": "relations.schema.json"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$(?![\\s\\S])"
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "action": {
            "enum": [
              "revise",
              "merge",
              "split",
              "undo",
              "redact"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "result_revision": {
            "type": "integer",
            "minimum": 0
          },
          "before": {
            "oneOf": [
              {
                "$ref": "#/$defs/state"
              },
              {
                "$ref": "#/$defs/manifest"
              }
            ]
          },
          "after": {
            "oneOf": [
              {
                "$ref": "#/$defs/state"
              },
              {
                "$ref": "#/$defs/manifest"
              }
            ]
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "redaction": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$(?![\\s\\S])"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "card_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$(?![\\s\\S])"
                },
                "uniqueItems": true
              },
              "original_content_sha256": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$(?![\\s\\S])"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
                }
              },
              "previous_wiki_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "reason_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "actor",
              "source_ids",
              "card_ids",
              "original_content_sha256",
              "previous_wiki_sha256",
              "reason_sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operation_id",
          "request_sha256",
          "action",
          "reason",
          "recorded_at",
          "base_revision",
          "result_revision",
          "before",
          "after",
          "before_sha256",
          "after_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "redact"
                }
              }
            },
            "then": {
              "required": [
                "redaction"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "redaction"
                ]
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "history_format": {
      "const": "content-addressed-v1"
    },
    "history_objects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "sources",
    "cards",
    "relations",
    "history"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "history_format": [
      "history_objects"
    ],
    "history_objects": [
      "history_format"
    ]
  }
}
